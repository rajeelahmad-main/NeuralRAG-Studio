# =============================================================================
# NeuralRAG Commercial AI Document Chat Platform — Environment Configuration
# =============================================================================

# Server-Side Gemini API Key (NEVER exposed to browser/client)
# You can set this here in .env, as a system environment variable, or in .streamlit/secrets.toml
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model ID (must match a supported model from /api/models)
DEFAULT_GEMINI_MODEL=gemini-3.1-flash-lite

# Storage & Database Configuration
DATABASE_PATH=./storage/neuralrag.db
UPLOADS_DIR=./storage/uploads
VECTOR_INDEX_DIR=./storage/indexes

# Security & Rate Limiting
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# RAG & Corrective RAG (CRAG) Thresholds
DEFAULT_TOP_K=5
CRAG_RELEVANCE_THRESHOLD=0.22
CRAG_AMBIGUOUS_THRESHOLD=0.12
CRAG_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# Server Ports
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
